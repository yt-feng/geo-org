# Public-facing service identity
PUBLIC_BASE_URL=https://tokvilo.com
PUBLIC_BRAND_NAME=tokvilo

# Managed authentication provider (keep the service key server-side)
AUTH_BASE_URL=
AUTH_ANON_KEY=
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional existing APIMart key. Admin-saved encrypted configuration takes priority.
APIMART_API_KEY=

# Upstream API configuration (production secrets belong in the host)
UPSTREAM_BASE_URL=
UPSTREAM_OPENAPI_URL=
UPSTREAM_PRICE_ENDPOINT=
UPSTREAM_API_TOKEN=
UPSTREAM_MARKERS=
UPSTREAM_REPLACEMENTS_JSON=[]
UPSTREAM_PATH_REWRITES={}
UPSTREAM_TIMEOUT_MS=90000
UPSTREAM_SPEND_LIMIT_USD=1

# Free-tier guardrails
GLOBAL_PROXY_DAILY_LIMIT=5000
DEFAULT_USER_DAILY_LIMIT=100
MAX_ACTIVE_KEYS_PER_USER=5
SERVICE_ENABLED=false

# Tokvilo prepaid balance / Liandong redemption. This is the fixed recharge
# conversion disclosed before checkout, not a live foreign-exchange quote.
USD_CNY=7.2
REDEMPTION_ENABLED=false
REDEMPTION_ISSUANCE_ENABLED=false
LIANDONG_SALES_ENABLED=false
LIANDONG_STORE_URL=https://wzyp.cn/shop/EMSW320D
LIANDONG_PRODUCT_30_URL=
LIANDONG_PRODUCT_90_URL=
LIANDONG_PRODUCT_300_URL=

# Paddle API software usage packs. Leave sales off until this exact domain and
# the disclosed API product scope have been approved and checkout is verified.
PADDLE_ENVIRONMENT=production
PADDLE_SALES_ENABLED=false
PADDLE_APPROVED_DOMAIN=
PADDLE_APPROVED_PRODUCT_SCOPE=
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_20_ID=
PADDLE_PRICE_50_ID=
PADDLE_PRICE_100_ID=
