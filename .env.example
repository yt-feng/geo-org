# Public-facing service identity
PUBLIC_BASE_URL=https://api.eco-geo.com
PUBLIC_BRAND_NAME=Eco Geo API

# Managed authentication provider (keep the service key server-side)
AUTH_BASE_URL=
AUTH_ANON_KEY=
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Upstream API configuration (production secrets belong in the host)
UPSTREAM_BASE_URL=
UPSTREAM_OPENAPI_URL=
UPSTREAM_API_TOKEN=
UPSTREAM_MARKERS=
UPSTREAM_REPLACEMENTS_JSON=[]
UPSTREAM_PATH_REWRITES={}
UPSTREAM_TIMEOUT_MS=90000

# Free-tier guardrails
GLOBAL_PROXY_DAILY_LIMIT=8000
DEFAULT_USER_DAILY_LIMIT=100
MAX_ACTIVE_KEYS_PER_USER=5
SERVICE_ENABLED=false
